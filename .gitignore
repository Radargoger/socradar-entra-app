# 1. THE MOST CRITICAL FILE: LOCAL SECRETS AND SETTINGS
# This file stores sensitive information like CLIENT_SECRET, API_KEY, and connection strings 
# used for local development/testing. It MUST NOT be committed to GitHub.
local.settings.json

# ---------------------------------------------------------------------

# 2. Python Environment and Compiler Outputs
# Virtual environment folder (where packages are installed)
.venv/
env/
venv/

# Python compiled code and cache
__pycache__/
*.pyc
*.pyo

# 3. Azure Functions Specific Outputs
# Temporary files generated during deployment or local run
.funcignore

# 4. Logs and Temporary Files
*.log
*.sqlite
/tmp/

# 5. Operating System Specific Files (Tidy up)
# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
